# All secrets are server-only. Never prefix these values with NEXT_PUBLIC_.
# Contact delivery requires a Resend account and a verified sending domain.
RESEND_API_KEY=
# Bare verified sender email address. Do not use an unverified sender.
EMAIL_FROM=

# Required for production contact delivery and optional paid assistant requests.
# Use the HTTPS REST endpoint from your Upstash Redis database dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a unique random secret of at least 32 characters. Used only to hash
# rate-limit identities. Rotation resets identifier buckets.
RATE_LIMIT_SECRET=
# Hard maximum attempted inquiries per UTC day; each may send two emails.
# Default 100, enforced maximum 1,000. Provider-side billing alerts are also required.
CONTACT_DAILY_CAP=100

# Optional exact HTTPS preview origin, without a path or trailing slash.
# Production always allows the canonical origin https://codinginx.com.
SITE_PREVIEW_ORIGIN=
# On non-Vercel hosting, set ONLY when your trusted proxy replaces this header.
# Allowed: x-real-ip or x-forwarded-for. Blank uses one shared anonymous bucket.
# Vercel uses its platform-controlled x-vercel-forwarded-for automatically.
TRUSTED_PROXY_IP_HEADER=

# Optional assistant classification, disabled by default. Guided answers always
# work. Enabling AI sends the visitor's current message to OpenAI; review privacy.
CHAT_AI_ENABLED=false
OPENAI_API_KEY=
# Bounded classification only; answers come from approved static site knowledge.
OPENAI_MODEL=gpt-4o-mini
CHAT_AI_DAILY_CAP=100

# Optional consent-gated Plausible analytics adapter. Enable only after configuring its
# destination and reviewing the privacy notice. No account has been supplied.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Indexing is disabled until ALL launch gates are independently verified.
NEXT_PUBLIC_SITE_LAUNCHED=false
# If CHAT_AI_ENABLED is enabled, also set this disclosure switch at build time.
NEXT_PUBLIC_CHAT_AI_ENABLED=false
